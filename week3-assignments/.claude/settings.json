{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(python -m pytest*)",
      "Bash(python run.py*)",
      "Bash(pip install*)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find * -name *.py)",
      "Bash(grep *)",
      "Bash(mkdir -p *)",
      "Bash(cp * *)",
      "Bash(mv src/* src/*)",
      "Write(src/*)",
      "Write(tests/*)",
      "Write(docs/*)",
      "Write(.claude/*)",
      "Write(CLAUDE.md)",
      "Write(README.md)",
      "Edit(src/*)",
      "Edit(tests/*)",
      "Edit(docs/*)",
      "Edit(.claude/*)",
      "Edit(CLAUDE.md)",
      "MultiEdit(src/*)",
      "MultiEdit(tests/*)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(sudo *)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(git reset --hard*)",
      "Bash(DROP TABLE*)",
      "Bash(DROP DATABASE*)",
      "Write(.env*)",
      "Write(*.env)",
      "Write(migrations/*)",
      "Write(.git/*)",
      "Edit(.env*)",
      "Edit(migrations/*)",
      "Edit(.git/*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/validate-bash.py"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/check-secrets.py"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/scope-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/audit-log.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/log-prompts.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/session-summary.py"
          }
        ]
      }
    ]
  },
  "model": "claude-sonnet-4-20250514",
  "permissionMode": "default"
}
