# HealthTrack API — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit your .env file — it contains real secrets.

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=CHANGE_ME_use_a_long_random_string

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_NAME=healthtrack
DB_USER=healthtrack_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# Redis cache
REDIS_URL=redis://cache:6379/0

# Anthropic API — get your key from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
